# WiRoc custom image filename.
#
# The Armbian default is:
#   ${VENDOR}_${IMAGE_VERSION}_${BOARD^}_${RELEASE}_${BRANCH}_${kernel}
#   e.g. Armbian-unofficial_25.11.0-trunk-esp32_Nanopiair_trixie_current_6.12.51
#
# We override it to a WiRoc-specific scheme:
#   WiRoc_<hwversion>_<pythonversion>_<baseimageversion>-<release>_<branch>_<kernel>
#   e.g. WiRoc_v8Rev2_1.46_25.11.0-trunk-trixie_current_6.12.51
#
# The board name ("Nanopiair") and the variant suffix ("-esp32"/"-nanopiair") are
# intentionally left out of the filename.
function calculate_image_version() {
	declare kernel_version_for_image="unknown"
	kernel_version_for_image="${IMAGE_INSTALLED_KERNEL_VERSION/-$LINUXFAMILY/}"

	# Base image version. IMAGE_VERSION is e.g. "25.11.0-trunk-esp32"; strip the
	# trailing "-<WIROC_VARIANT>" so we get "25.11.0-trunk". Fall back to REVISION
	# when IMAGE_VERSION is unset (the base "wiroc" config does not set it).
	local base_version="${IMAGE_VERSION:-${REVISION}}"
	if [[ -n "${WIROC_VARIANT:-}" ]]; then
		base_version="${base_version%-${WIROC_VARIANT}}"
	fi

	calculated_image_version="WiRoc_${WIROC_HW_VERSION}_${WIROC_PYTHON_VERSION}_${base_version}-${RELEASE}_${BRANCH}_${kernel_version_for_image}${DESKTOP_ENVIRONMENT:+_$DESKTOP_ENVIRONMENT}${EXTRA_IMAGE_SUFFIX}"
	[[ $BUILD_DESKTOP == yes ]] && calculated_image_version=${calculated_image_version}_desktop
	[[ $BUILD_MINIMAL == yes ]] && calculated_image_version=${calculated_image_version}_minimal
	[[ $ROOTFS_TYPE == nfs ]] && calculated_image_version=${calculated_image_version}_nfsboot
	display_alert "Calculated image version" "${calculated_image_version}" "debug"
}
